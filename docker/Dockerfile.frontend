FROM python:3.11-slim

WORKDIR /app

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    pkg-config \
    libfreetype6-dev \
    libpng-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install only frontend-relevant dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --root-user-action=ignore --upgrade pip setuptools wheel \
    && pip install --root-user-action=ignore --no-cache-dir torch==2.0.1 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --root-user-action=ignore --no-cache-dir \
        streamlit==1.26.0 \
        pandas==2.1.0 \
        numpy==1.25.2 \
        python-dotenv==1.0.0 \
        requests==2.31.0 \
        ccxt==4.0.23 \
        pycoingecko==3.1.0

# Copy frontend application
COPY frontend/ .

# Verify app.py exists
RUN test -f app.py || (echo "❌ Error: app.py not found in /app" && exit 1)

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose Streamlit port
EXPOSE 8501

# Launch Streamlit
CMD ["streamlit", "run", "app.py", "--server.port", "8501", "--server.address", "0.0.0.0"]